# StudyFlow AI — Environment Variables
# Copy to .env.local (apps/student-web, apps/admin-web) and fill in real values.
# NEVER commit real secrets. service_role keys must only ever be used server-side.

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ---- Owner bootstrap ----
# Email that will be auto-bootstrapped into OWNER role on first verified login.
# See docs/architecture/founder-bootstrap.md
OWNER_BOOTSTRAP_EMAIL=viexlatam@gmail.com

# ---- AI Providers (AIProvider abstraction — packages/ai-core) ----
# Only the configured provider is required at runtime; others may be left blank.
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ---- Billing (BillingProvider abstraction — not wired to a real processor yet) ----
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- Notifications ----
FIREBASE_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=

# ---- Email ----
RESEND_API_KEY=

# ---- Integrations (docs/duoc-integration) ----
BLACKBOARD_CLIENT_ID=
BLACKBOARD_CLIENT_SECRET=
BLACKBOARD_BASE_URL=

# ---- Observability ----
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
